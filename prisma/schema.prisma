generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled endpoint for the running app: each serverless function opens its own
  // connection, so it must go through Neon's pooler.
  url       = env("DATABASE_URL")
  // Migrations cannot run through pgBouncer - Prisma reports a misleading
  // "P1001: Can't reach database server" - so they use the unpooled endpoint.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  clerkId        String          @unique
  createdAt      DateTime        @default(now())
  firstName      String?
  imageUrl       String?
  lastName       String?
  role           UserRole        @default(USER)
  updatedAt      DateTime        @updatedAt
  playlists      Playlist[]
  problems       Problem[]
  solvedProblems ProblemSolved[]
  submissions    Submission[]

  @@index([role])
}

model Pattern {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String
  // Learning order shown on /patterns. Not unique: ties are fine, we fall back
  // to name for a stable sort.
  order       Int       @default(0)
  color       String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  problems    Problem[]

  @@index([order])
}

model Problem {
  id                 String              @id @default(uuid())
  // Human-facing identifier ("1. Two Sum"). Sequence-backed, so it is stable
  // and never reused; the uuid stays the routing/relation key.
  number             Int                 @unique @default(autoincrement())
  title              String
  description        String
  difficulty         Difficulty
  // Secondary metadata only. The primary browse axis is primaryPattern.
  tags               String[]
  primaryPatternId   String?
  userId             String
  examples           Json
  constraints        String
  hints              String?
  editorial          String?
  testCases          Json
  codeSnippets       Json
  referenceSolutions Json
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a pattern must never delete problems.
  primaryPattern     Pattern?            @relation(fields: [primaryPatternId], references: [id], onDelete: SetNull)
  problemsPlaylists  ProblemInPlaylist[]
  solvedBy           ProblemSolved[]
  submissions        Submission[]

  @@index([difficulty])
  @@index([primaryPatternId])
}

model Submission {
  id            String           @id @default(uuid())
  userId        String
  problemId     String
  sourceCode    Json
  language      String
  stdin         String?
  stdout        String?
  stderr        String?
  compileOutput String?
  status        String
  memory        String?
  time          String?
  createdAt     DateTime         @default(now())
  problem       Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  testCases     TestCaseResult[]

  @@index([status])
  @@index([userId, problemId])
  @@index([problemId])
}

model TestCaseResult {
  id            String     @id @default(uuid())
  submissionId  String
  testCase      Int
  passed        Boolean
  stdout        String?
  expected      String
  stderr        String?
  compileOutput String?
  status        String
  memory        String?
  time          String?
  createdAt     DateTime   @default(now())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ProblemSolved {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId])
}

model Playlist {
  id          String              @id @default(uuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems    ProblemInPlaylist[]

  @@unique([name, userId])
}

model ProblemInPlaylist {
  id         String   @id @default(uuid())
  playlistId String
  problemId  String
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([playlistId, problemId])
}

enum UserRole {
  ADMIN
  USER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
